{
  "hosting": {
    "site": "ai-invoicing",
    "public": "build/site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/app/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/app/vendor/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/app/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|main.dart.js|llm_bridge.js|pdf_bridge.js|pdf_preview.js|version.json|manifest.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(sitemap.xml|robots.txt|og-image.png)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/@(zh|ja|pt|es)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/@(site-runtime.js|builder/**|s/**)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(landing.css|contact.js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/s/**",
        "destination": "/s/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/en",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/en/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/download",
        "destination": "/#download",
        "type": 302
      },
      {
        "source": "/download/",
        "destination": "/#download",
        "type": 302
      }
    ]
  }
}
